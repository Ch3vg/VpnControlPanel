app:
  name: vpn-control-panel
  max_secure: false
  environment: development

server:
  host: "0.0.0.0"
  port: 8000

database:
  url: "postgresql+asyncpg://user:pass@localhost/panel"

security:
  secret_key: "replace-with-at-least-32-char-jwt-secret-key"
  encryption_key: "replace-with-at-least-32-char-db-encryption-key"
  jwt_algorithm: HS256
  jwt_expire_minutes: 60

broker:
  url: "http://127.0.0.1:8001"
  api_key: "replace-with-at-least-32-char-secret-key"

worker:
  worker_id: "panel-worker-1"
  task_types:
    - config.initialize
    - config.regenerate

paths:
  configs: "/opt/vpn/configs"
  templates: "configs"

rate_limit:
  login:
    max_attempts: 5
    window_seconds: 900
  share:
    max_requests: 30
    window_seconds: 60

audit:
  enabled: true
  log_failed_login: true

metrics:
  enabled: true

security_headers:
  enabled: true

web:
  enabled: true
  mount_path: /admin

systemd:
  per_config: true
  unit_dir: /etc/systemd/system
  service_prefix: vpn
  xray_binary: /usr/local/bin/xray
  hysteria_binary: /usr/local/bin/hysteria
  xray_config_dir: /usr/local/etc/xray/configs
  hysteria_config_dir: /usr/local/etc/hysteria/configs
  service_ready_timeout_seconds: 30
  service_ready_settle_seconds: 2
  service_ready_max_wait_seconds: 600

vpn:
  public_host: "vpn.example.com"
  connectivity_probe_enabled: true
  connectivity_probe_timeout_seconds: 12
  connectivity_probe_cache_seconds: 60
  connectivity_probe_url: "https://ya.ru/"
  profiles:
    xray-reality:
      template_file: config_reality.json
      service_name: xray_reality
      config_filename: config.json
      inbound_tag: vless-reality-in
      port_candidates: [8443, 2053, 2083, 2096, 9443, 10443, 8444]
      reality_dest_hosts: [ya.ru:443, vk.com:443, gosuslugi.ru:443, pochta.ru:443]
      reality_server_names: [ya.ru, gosuslugi.ru, vk.com, pochta.ru]
      # When nginx SNI mux owns public :443, advertise 443 in share URIs and bind Reality on loopback.
      # share_public_host is the dial address in vless:// only — Reality sni= stays dest (ya.ru, …).
      # share_public_host: auth.example.com
      # share_public_port: 443
      # listen_address: "127.0.0.1"
      active_config_path: /usr/local/etc/xray/config_reality.json
    xray-grpc:
      template_file: config_grpc.json
      service_name: xray_grpc
      config_filename: config.json
      inbound_tag: vless-grpc-trusted
      port_candidates: [8443, 2053, 2083, 2096, 9443, 10443, 4433, 8444]
      cert_dir: /usr/local/etc/xray/certs
      cert_prefix: grpc
      # tls_cert_file: /etc/letsencrypt/live/example.com/fullchain.pem
      # tls_key_file: /etc/letsencrypt/live/example.com/privkey.pem
      grpc_sni_hosts: [ya.ru, gosuslugi.ru, www.microsoft.com, vk.com, kremlin.ru, pochta.ru, government.ru, rzd.ru]
      grpc_service_names: [Drive, Download, Api, TunService, v1.Messenger, grpc.health.v1.Health]
      active_config_path: /usr/local/etc/xray/config_grpc.json
    xray-xhttp:
      template_file: config_xhttp.json
      service_name: xray_xhttp
      config_filename: config.json
      inbound_tag: vless-xhttp-in
      port_candidates: [8443, 9443, 10443, 8080, 8444, 2083, 2096, 8888]
      cert_dir: /usr/local/etc/xray/certs
      cert_prefix: xhttp
      # tls_cert_file: /etc/letsencrypt/live/example.com/fullchain.pem
      # tls_key_file: /etc/letsencrypt/live/example.com/privkey.pem
      xhttp_hosts: []
      xhttp_paths: [/search, /assets, /api, /download, /news, /login]
      active_config_path: /usr/local/etc/xray/config_xhttp.json
    hysteria2:
      template_file: hysteria.server.yaml
      service_name: hysteria-server
      config_filename: config.yaml
      inbound_tag: ""
      port_candidates: [8443, 3478, 8800, 1935, 8080, 5000, 9443, 10443]
      cert_dir: /usr/local/etc/xray/certs
      cert_prefix: hysteria
      # tls_cert_file: /etc/letsencrypt/live/example.com/fullchain.pem
      # tls_key_file: /etc/letsencrypt/live/example.com/privkey.pem
      active_config_path: /usr/local/etc/hysteria/config.yaml

telegram:
  enabled: false
  bot_token: ""
  chat_id: ""
