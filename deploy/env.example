# Copy to deploy/.env and adjust before running make deploy
# cp deploy/env.example deploy/.env

# --- Paths ---
VCP_INSTALL_DIR=/opt/vpn-control-panel
VCP_CONFIG_DIR=/etc/vpn-control-panel
VCP_DATA_DIR=/var/lib/vpn-control-panel
VCP_VPN_CONFIGS_DIR=/opt/vpn/configs
VCP_CERT_DIR=/usr/local/etc/xray/certs
VCP_HYSTERIA_CONFIG_DIR=/usr/local/etc/hysteria
VCP_TEMPLATES_DIR=/opt/vpn-control-panel/configs

# --- OS users ---
VCP_PANEL_USER=vpn-panel
VCP_WORKER_USER=vpn-worker
VCP_WORKER_INSTANCES=1

# --- PostgreSQL (panel DB) ---
VCP_DB_HOST=127.0.0.1
VCP_DB_PORT=5432
VCP_DB_NAME=vpn_panel
VCP_DB_USER=vpn_panel
VCP_DB_PASSWORD=

# --- Secrets (leave empty to auto-generate via make secrets) ---
VCP_JWT_SECRET=
VCP_ENCRYPTION_KEY=
VCP_BROKER_API_KEY=

# --- Network / public ---
VCP_PUBLIC_HOST=vpn.example.com
VCP_PANEL_DOMAIN=panel.example.com
VCP_API_HOST=127.0.0.1
VCP_API_PORT=8000
VCP_BROKER_HOST=127.0.0.1
VCP_BROKER_PORT=8001

# --- VPN connectivity probe (rendered into panel.yaml on make update) ---
VCP_CONNECTIVITY_PROBE_ENABLED=true
VCP_CONNECTIVITY_PROBE_TIMEOUT_SECONDS=12
VCP_CONNECTIVITY_PROBE_CACHE_SECONDS=60
VCP_CONNECTIVITY_PROBE_URL=https://ya.ru/

# --- Nginx: 0 = HTTP :80 only, 1 = HTTPS :443 (needs certs) ---
VCP_NGINX_SSL=0

# --- Optional: share public TCP 443 between panel HTTPS and Reality (SNI mux) ---
# When 1: public :443 is nginx stream; panel TLS on 127.0.0.1:8443; Reality on loopback.
# Takes precedence over VCP_NGINX_SSL listen :443. Keep Reality listen=127.0.0.1 (not 0.0.0.0:443).
# VCP_NGINX_SHARED_443=0
# VCP_REALITY_BACKEND=127.0.0.1:10443
# VCP_PANEL_TLS_BACKEND=127.0.0.1:8443
# VCP_REALITY_SNI_LIST=ya.ru,vk.com,gosuslugi.ru,pochta.ru
# Certs for loopback panel HTTPS (LE or self-signed):
# VCP_PANEL_TLS_CERT=/etc/letsencrypt/live/panel.example.com/fullchain.pem
# VCP_PANEL_TLS_KEY=/etc/letsencrypt/live/panel.example.com/privkey.pem

# Stable LE for VPN TLS profiles (xHTTP / gRPC / Hysteria) — set in panel.yaml profiles:
#   tls_cert_file: /etc/letsencrypt/live/example.com/fullchain.pem
#   tls_key_file: /etc/letsencrypt/live/example.com/privkey.pem
# (panel.yaml is rendered from deploy/templates/panel.yaml.in; edit the template or post-render.)
# Deploy/update runs fix-letsencrypt-perms so vpn-worker can read these paths (ssl-cert group +
# certbot renew hook). Optional overrides:
# VCP_SSL_CERT_GROUP=ssl-cert
# VCP_LETSENCRYPT_DIR=/etc/letsencrypt

# --- task-broker wheel (required for make install-app) ---
VCP_TASK_BROKER_WHL=/path/to/task_broker-1.0.0-py3-none-any.whl

# --- First admin user ---
VCP_ADMIN_USERNAME=admin

# --- Cron: username for vpn-regenerate-all / regenerate-all-configs.sh ---
# VCP_CRON_ADMIN_USERNAME=admin

# --- Optional: set for non-interactive admin creation (discouraged in production) ---
# VCP_ADMIN_PASSWORD=
