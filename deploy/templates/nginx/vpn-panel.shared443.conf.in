# Panel with shared TCP 443 (SNI mux on public :443).
# :80 stays plain HTTP (no cert, no force-HTTPS).
# Loopback :8443 is optional HTTPS for SNI=panel domain via the stream mux.
server {
    listen 80;
    server_name ${VCP_PANEL_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    client_max_body_size 1m;

    location / {
        proxy_pass http://${VCP_API_HOST}:${VCP_API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 127.0.0.1:8443 ssl http2;
    server_name ${VCP_PANEL_DOMAIN};

    ssl_certificate     ${VCP_PANEL_TLS_CERT};
    ssl_certificate_key ${VCP_PANEL_TLS_KEY};

    client_max_body_size 1m;

    location / {
        proxy_pass http://${VCP_API_HOST}:${VCP_API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
